{
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# GPU-Accelerated HDBSCAN Clustering\n",
                "\n",
                "This notebook demonstrates the GPU-accelerated HDBSCAN implementation for hierarchical density-based clustering."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import numpy as np\n",
                "import matplotlib.pyplot as plt\n",
                "import time\n",
                "from ghdbscan import HDBSCAN, HDBSCAN_GPU\n",
                "\n",
                "np.random.seed(42)"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 1. Check GPU Availability"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "gpu_available = HDBSCAN_GPU.is_available()\n",
                "print(f\"GPU Available: {gpu_available}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 2. Generate Data with Varying Densities\n",
                "\n",
                "HDBSCAN excels at finding clusters with different densities."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Create clusters with different densities\n",
                "dense_cluster = np.random.randn(500, 2) * 0.3 + [0, 0]\n",
                "medium_cluster = np.random.randn(500, 2) * 0.8 + [4, 4]\n",
                "sparse_cluster = np.random.randn(500, 2) * 1.2 + [8, 0]\n",
                "noise = np.random.uniform(-2, 10, (100, 2))\n",
                "\n",
                "X = np.vstack([dense_cluster, medium_cluster, sparse_cluster, noise])\n",
                "\n",
                "print(f\"Dataset shape: {X.shape}\")\n",
                "print(f\"Total points: {len(X)}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Visualize the Data"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "plt.figure(figsize=(10, 6))\n",
                "plt.scatter(X[:, 0], X[:, 1], alpha=0.5, s=20)\n",
                "plt.title('Data with Varying Densities')\n",
                "plt.xlabel('Feature 1')\n",
                "plt.ylabel('Feature 2')\n",
                "plt.grid(True, alpha=0.3)\n",
                "plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 4. CPU HDBSCAN Clustering"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "print(\"Running CPU HDBSCAN...\")\n",
                "start_time = time.time()\n",
                "\n",
                "hdbscan_cpu = HDBSCAN(min_cluster_size=50)\n",
                "labels_cpu = hdbscan_cpu.fit_predict(X)\n",
                "\n",
                "cpu_time = time.time() - start_time\n",
                "\n",
                "n_clusters_cpu = len(set(labels_cpu)) - (1 if -1 in labels_cpu else 0)\n",
                "n_noise_cpu = list(labels_cpu).count(-1)\n",
                "\n",
                "print(f\"CPU Time: {cpu_time:.4f} seconds\")\n",
                "print(f\"Clusters found: {n_clusters_cpu}\")\n",
                "print(f\"Noise points: {n_noise_cpu}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 5. GPU HDBSCAN Clustering"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "print(\"Running GPU HDBSCAN...\")\n",
                "start_time = time.time()\n",
                "\n",
                "hdbscan_gpu = HDBSCAN_GPU(min_cluster_size=50)\n",
                "labels_gpu = hdbscan_gpu.fit_predict(X)\n",
                "\n",
                "gpu_time = time.time() - start_time\n",
                "\n",
                "n_clusters_gpu = len(set(labels_gpu)) - (1 if -1 in labels_gpu else 0)\n",
                "n_noise_gpu = list(labels_gpu).count(-1)\n",
                "\n",
                "print(f\"GPU Time: {gpu_time:.4f} seconds\")\n",
                "print(f\"Clusters found: {n_clusters_gpu}\")\n",
                "print(f\"Noise points: {n_noise_gpu}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 6. Performance Comparison"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "speedup = cpu_time / gpu_time if gpu_time > 0 else 0\n",
                "\n",
                "print(f\"\\n{'='*50}\")\n",
                "print(\"Performance Comparison\")\n",
                "print(f\"{'='*50}\")\n",
                "print(f\"CPU Time:  {cpu_time:.4f}s\")\n",
                "print(f\"GPU Time:  {gpu_time:.4f}s\")\n",
                "print(f\"Speedup:   {speedup:.2f}x\")\n",
                "\n",
                "# Visualization\n",
                "fig, ax = plt.subplots(1, 2, figsize=(14, 5))\n",
                "\n",
                "ax[0].bar(['CPU', 'GPU'], [cpu_time, gpu_time], color=['#3498db', '#2ecc71'])\n",
                "ax[0].set_ylabel('Time (seconds)')\n",
                "ax[0].set_title('Execution Time')\n",
                "ax[0].grid(True, alpha=0.3)\n",
                "\n",
                "ax[1].barh(['Speedup'], [speedup], color='#e74c3c')\n",
                "ax[1].set_xlabel('Speedup Factor')\n",
                "ax[1].set_title('GPU Speedup')\n",
                "ax[1].grid(True, alpha=0.3)\n",
                "\n",
                "plt.tight_layout()\n",
                "plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 7. Visualize Clustering Results"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n",
                "\n",
                "# CPU results\n",
                "unique_labels_cpu = set(labels_cpu)\n",
                "colors = [plt.cm.Spectral(each) for each in np.linspace(0, 1, len(unique_labels_cpu))]\n",
                "\n",
                "for k, col in zip(unique_labels_cpu, colors):\n",
                "    if k == -1:\n",
                "        col = [0, 0, 0, 1]\n",
                "    \n",
                "    class_member_mask = (labels_cpu == k)\n",
                "    xy = X[class_member_mask]\n",
                "    ax1.scatter(xy[:, 0], xy[:, 1], c=[col], s=30, alpha=0.6)\n",
                "\n",
                "ax1.set_title(f'CPU HDBSCAN\\n{n_clusters_cpu} clusters, {n_noise_cpu} noise')\n",
                "ax1.set_xlabel('Feature 1')\n",
                "ax1.set_ylabel('Feature 2')\n",
                "ax1.grid(True, alpha=0.3)\n",
                "\n",
                "# GPU results\n",
                "unique_labels_gpu = set(labels_gpu)\n",
                "colors = [plt.cm.Spectral(each) for each in np.linspace(0, 1, len(unique_labels_gpu))]\n",
                "\n",
                "for k, col in zip(unique_labels_gpu, colors):\n",
                "    if k == -1:\n",
                "        col = [0, 0, 0, 1]\n",
                "    \n",
                "    class_member_mask = (labels_gpu == k)\n",
                "    xy = X[class_member_mask]\n",
                "    ax2.scatter(xy[:, 0], xy[:, 1], c=[col], s=30, alpha=0.6)\n",
                "\n",
                "ax2.set_title(f'GPU HDBSCAN\\n{n_clusters_gpu} clusters, {n_noise_gpu} noise')\n",
                "ax2.set_xlabel('Feature 1')\n",
                "ax2.set_ylabel('Feature 2')\n",
                "ax2.grid(True, alpha=0.3)\n",
                "\n",
                "plt.tight_layout()\n",
                "plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 8. Performance Scaling Test"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "sizes = [500, 1000, 2000, 3000, 5000]\n",
                "cpu_times = []\n",
                "gpu_times = []\n",
                "\n",
                "for size in sizes:\n",
                "    print(f\"Testing with {size} points...\")\n",
                "    \n",
                "    X_test = np.vstack([\n",
                "        np.random.randn(size // 3, 2) * 0.5 + [0, 0],\n",
                "        np.random.randn(size // 3, 2) * 0.8 + [5, 5],\n",
                "        np.random.randn(size // 3, 2) * 1.0 + [10, 0]\n",
                "    ])\n",
                "    \n",
                "    # CPU\n",
                "    start = time.time()\n",
                "    hdbscan_cpu = HDBSCAN(min_cluster_size=20)\n",
                "    _ = hdbscan_cpu.fit_predict(X_test)\n",
                "    cpu_times.append(time.time() - start)\n",
                "    \n",
                "    # GPU\n",
                "    start = time.time()\n",
                "    hdbscan_gpu = HDBSCAN_GPU(min_cluster_size=20)\n",
                "    _ = hdbscan_gpu.fit_predict(X_test)\n",
                "    gpu_times.append(time.time() - start)\n",
                "\n",
                "# Plot\n",
                "plt.figure(figsize=(12, 6))\n",
                "plt.plot(sizes, cpu_times, 'o-', label='CPU', linewidth=2, markersize=8)\n",
                "plt.plot(sizes, gpu_times, 's-', label='GPU', linewidth=2, markersize=8)\n",
                "plt.xlabel('Dataset Size')\n",
                "plt.ylabel('Time (seconds)')\n",
                "plt.title('HDBSCAN Performance Scaling')\n",
                "plt.legend()\n",
                "plt.grid(True, alpha=0.3)\n",
                "plt.show()\n",
                "\n",
                "# Speedup\n",
                "speedups = [cpu / gpu if gpu > 0 else 0 for cpu, gpu in zip(cpu_times, gpu_times)]\n",
                "plt.figure(figsize=(12, 6))\n",
                "plt.plot(sizes, speedups, 'o-', color='#e74c3c', linewidth=2, markersize=8)\n",
                "plt.axhline(y=1, color='gray', linestyle='--')\n",
                "plt.xlabel('Dataset Size')\n",
                "plt.ylabel('Speedup Factor')\n",
                "plt.title('GPU Speedup vs Dataset Size')\n",
                "plt.grid(True, alpha=0.3)\n",
                "plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## Conclusion\n",
                "\n",
                "This notebook demonstrated GPU-accelerated HDBSCAN clustering:\n",
                "- Handles varying density clusters effectively\n",
                "- Provides performance improvements for large datasets\n",
                "- Maintains compatibility with CPU implementation\n",
                "\n",
                "**Advantages of HDBSCAN:**\n",
                "- No epsilon parameter needed\n",
                "- Handles varying density clusters\n",
                "- Provides hierarchical cluster structure"
            ]
        }
    ],
